''
' Linear RGB -> 38-band reflectance (Spectral.js lRGB_to_R): split the color
' into white + cyan/magenta/yellow + red/green/blue parts and sum their base
' spectra.
'
SUB PGM_lrgb_to_r (lr AS DOUBLE, lg AS DOUBLE, lb AS DOUBLE, refl() AS DOUBLE)
    DIM AS DOUBLE w, r0, g0, b0, c, m, y, r, g, b, v
    DIM i AS INTEGER
    w = lr: IF lg < w THEN w = lg
    IF lb < w THEN w = lb
    r0 = lr - w: g0 = lg - w: b0 = lb - w
    c = g0: IF b0 < c THEN c = b0
    m = r0: IF b0 < m THEN m = b0
    y = r0: IF g0 < y THEN y = g0
    r = r0 - b0: IF r0 - g0 < r THEN r = r0 - g0
    IF r < 0 THEN r = 0
    g = g0 - b0: IF g0 - r0 < g THEN g = g0 - r0
    IF g < 0 THEN g = 0
    b = b0 - g0: IF b0 - r0 < b THEN b = b0 - r0
    IF b < 0 THEN b = 0
    FOR i = 0 TO PGM_SIZE - 1
        v = w * PGM_TAB(0, i) + c * PGM_TAB(1, i) + m * PGM_TAB(2, i) + y * PGM_TAB(3, i) + r * PGM_TAB(4, i) + g * PGM_TAB(5, i) + b * PGM_TAB(6, i)
        IF v < 2.220446049250313D-16 THEN v = 2.220446049250313D-16
        refl(i) = v
    NEXT i
END SUB

''
' Fill the K/S cache slot for a color (returns the slot index).
'
FUNCTION PGM_ks_slot% (col AS _UNSIGNED LONG)
    DIM AS _UNSIGNED LONG c
    DIM AS INTEGER h, i
    DIM AS DOUBLE refl(0 TO PGM_SIZE - 1), y, rr
    c = col OR &HFF000000~&
    h = ((_RED32(c) * 7 + _GREEN32(c) * 13 + _BLUE32(c) * 31) AND (PGM_KS_CACHE_N - 1))
    IF PGM_KS_OK(h) _ANDALSO PGM_KS_COL(h) = c THEN PGM_ks_slot% = h: EXIT FUNCTION
    PGM_lrgb_to_r CLR_srgb_to_linear#(_RED32(c) / 255#), CLR_srgb_to_linear#(_GREEN32(c) / 255#), CLR_srgb_to_linear#(_BLUE32(c) / 255#), refl()
    y = 0
    FOR i = 0 TO PGM_SIZE - 1
        rr = refl(i)
        PGM_KS(h, i) = (1# - rr) * (1# - rr) / (2# * rr)
        y = y + PGM_TAB(8, i) * rr
    NEXT i
    IF y < 2.220446049250313D-16 THEN y = 2.220446049250313D-16
    PGM_KS_LUM(h) = y
    PGM_KS_COL(h) = c
    PGM_KS_OK(h) = -1
    PGM_ks_slot% = h
END FUNCTION

''
' Weighted pigment mix: w1 parts of c1 with w2 parts of c2 (Spectral.js mix()).
' Concentration = weight^2 * luminance, so dark pigments are strong tinters
' (a little blue goes a long way) as with real paint. Result is gamut-mapped
' into sRGB; alpha blends linearly by weight.
'
FUNCTION PGM_mix_w~& (c1 AS _UNSIGNED LONG, w1 AS SINGLE, c2 AS _UNSIGNED LONG, w2 AS SINGLE)
    DIM AS _UNSIGNED LONG ca, cb
    DIM AS INTEGER s1, s2, i
    DIM AS DOUBLE k1, k2, tot, ks, rr, x, y, z, fa, fb, wt
    DIM AS SINGLE lr, lg, lb
    DIM k AS _UNSIGNED LONG
    ca = c1: cb = c2: fa = w1: fb = w2
    IF fa < 0 THEN fa = 0
    IF fb < 0 THEN fb = 0
    IF fa + fb <= 0 THEN fa = 1
    PGM_init
    IF fb = 0 THEN PGM_mix_w~& = ca: EXIT FUNCTION
    IF fa = 0 THEN PGM_mix_w~& = cb: EXIT FUNCTION
    s1 = PGM_ks_slot%(ca)
    k1 = PGM_KS_LUM(s1) * fa * fa
    ' second color may evict the first from the cache only if they collide; copy first
    DIM ks1(0 TO PGM_SIZE - 1) AS DOUBLE
    FOR i = 0 TO PGM_SIZE - 1: ks1(i) = PGM_KS(s1, i): NEXT i
    s2 = PGM_ks_slot%(cb)
    k2 = PGM_KS_LUM(s2) * fb * fb
    tot = k1 + k2
    x = 0: y = 0: z = 0
    FOR i = 0 TO PGM_SIZE - 1
        ks = (ks1(i) * k1 + PGM_KS(s2, i) * k2) / tot
        rr = 1# + ks - SQR(ks * ks + 2# * ks)
        x = x + PGM_TAB(7, i) * rr
        y = y + PGM_TAB(8, i) * rr
        z = z + PGM_TAB(9, i) * rr
    NEXT i
    ' XYZ -> linear sRGB (Spectral.js matrix)
    lr = 3.2409699419045226# * x - 1.537383177570094# * y - 0.4986107602930034# * z
    lg = -0.9692436362808796# * x + 1.8759675015077202# * y + 0.04155505740717559# * z
    lb = 0.05563007969699366# * x - 0.20397695888897652# * y + 1.0569715142428786# * z
    k = PGM_gamut_map~&(lr, lg, lb)
    wt = fb / (fa + fb)
    PGM_mix_w~& = _RGBA32(_RED32(k), _GREEN32(k), _BLUE32(k), INT(_ALPHA32(ca) + (_ALPHA32(cb) - _ALPHA32(ca)) * wt + 0.5))
END FUNCTION

''
' Linear RGB -> 32-bit color, gamut-mapped exactly like Spectral.js gamutMap():
' binary search on OKLCh chroma (keeping L and h), accepting the clipped color
' as soon as it is within a just-noticeable difference (0.03 deltaE-OK).
'
FUNCTION PGM_gamut_map~& (lr AS SINGLE, lg AS SINGLE, lb AS SINGLE)
    DIM AS SINGLE l, a, b, c, h, mn, mx, ch, cl, ca, cb, r2, g2, b2, e, jnd, eps
    DIM minIn AS INTEGER
    jnd = 0.03: eps = 0.0001
    CLR_linear_to_oklab lr, lg, lb, l, a, b
    IF l >= 1 THEN PGM_gamut_map~& = _RGB32(255, 255, 255): EXIT FUNCTION
    IF l <= 0 THEN PGM_gamut_map~& = _RGB32(0, 0, 0): EXIT FUNCTION
    IF lr >= 0 _ANDALSO lr <= 1 _ANDALSO lg >= 0 _ANDALSO lg <= 1 _ANDALSO lb >= 0 _ANDALSO lb <= 1 THEN
        PGM_gamut_map~& = CLR_linear_to_rgb32~&(lr, lg, lb): EXIT FUNCTION
    END IF
    CLR_lab_to_lch l, a, b, l, c, h
    mn = 0: mx = c: minIn = -1
    PGM_clip_oklab lr, lg, lb, cl, ca, cb
    CLR_linear_to_oklab lr, lg, lb, l, a, b
    e = SQR((cl - l) ^ 2 + (ca - a) ^ 2 + (cb - b) ^ 2)
    IF e < jnd THEN PGM_gamut_map~& = PGM_oklab_rgb32~&(cl, ca, cb): EXIT FUNCTION
    DO WHILE mx - mn > eps
        ch = (mn + mx) / 2
        CLR_lch_to_lab l, ch, h, l, a, b
        CLR_oklab_to_linear l, a, b, r2, g2, b2
        IF minIn _ANDALSO r2 >= 0 _ANDALSO r2 <= 1 _ANDALSO g2 >= 0 _ANDALSO g2 <= 1 _ANDALSO b2 >= 0 _ANDALSO b2 <= 1 THEN
            mn = ch
        ELSE
            PGM_clip_oklab r2, g2, b2, cl, ca, cb
            e = SQR((cl - l) ^ 2 + (ca - a) ^ 2 + (cb - b) ^ 2)
            IF e < jnd THEN
                IF jnd - e < eps THEN EXIT DO
                minIn = 0: mn = ch
            ELSE
                mx = ch
            END IF
        END IF
    LOOP
    PGM_gamut_map~& = PGM_oklab_rgb32~&(cl, ca, cb)
END FUNCTION

''
' OKLab of the channel-clamped linear color.
'
SUB PGM_clip_oklab (lr AS SINGLE, lg AS SINGLE, lb AS SINGLE, ol AS SINGLE, oa AS SINGLE, ob AS SINGLE)
    DIM AS SINGLE r, g, b
    r = lr: g = lg: b = lb
    IF r < 0 THEN r = 0
    IF r > 1 THEN r = 1
    IF g < 0 THEN g = 0
    IF g > 1 THEN g = 1
    IF b < 0 THEN b = 0
    IF b > 1 THEN b = 1
    CLR_linear_to_oklab r, g, b, ol, oa, ob
END SUB

''
' OKLab -> 32-bit color with plain clamping (input already in gamut).
'
FUNCTION PGM_oklab_rgb32~& (l AS SINGLE, a AS SINGLE, b AS SINGLE)
    DIM AS SINGLE r, g, bl
    CLR_oklab_to_linear l, a, b, r, g, bl
    PGM_oklab_rgb32~& = CLR_linear_to_rgb32~&(r, g, bl)
END FUNCTION

''
' Pigment blend from c1 (t = 0) to c2 (t = 1).
'
FUNCTION PGM_mix~& (c1 AS _UNSIGNED LONG, c2 AS _UNSIGNED LONG, t AS SINGLE)
    DIM u AS SINGLE
    u = t
    IF u < 0 THEN u = 0
    IF u > 1 THEN u = 1
    PGM_mix~& = PGM_mix_w~&(c1, 1 - u, c2, u)
END FUNCTION
