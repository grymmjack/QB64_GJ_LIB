$INCLUDEONCE

' ============================================================================
' COLOR-PIGMENT.BM — Pigment mixing (port of Spectral.js; see COLOR-PIGMENT.BI)
' Requires COLOR-SPACES (CLR_) for transfer functions and gamut mapping.
' ============================================================================

''
' Parse one comma-separated table row into PGM_TAB(row, 0..37).
'
SUB PGM_parse_row (t AS STRING, row AS INTEGER)
    DIM AS LONG p, q, i
    p = 1
    FOR i = 0 TO PGM_SIZE - 1
        q = INSTR(p, t, ",")
        IF q = 0 THEN q = LEN(t) + 1
        PGM_TAB(row, i) = VAL(MID$(t, p, q - p))
        p = q + 1
    NEXT i
END SUB

''
' Load the spectral tables (called automatically on first use).
'
SUB PGM_init
    DIM t AS STRING
    IF PGM_READY THEN EXIT SUB
    ' base spectrum W
    t$ = "1.00116072718764, 1.00116065159728, 1.00116031922747, 1.00115867270789, 1.00115259844552, 1.00113252528998"
    t$ = t$ + ", 1.00108500663327, 1.00099687889453, 1.00086525152274, 1.0006962900094, 1.00050496114888, 1.00030808187992"
